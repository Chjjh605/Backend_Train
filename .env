# ===============================================================================
# 💻 로컬 개발 환경 전용 설정 (.env)
# ⚠️ 주의: 이 파일은 로컬 PC 테스트 전용입니다.
# ☁️ AWS EKS 배포 시에는 이 파일 대신 ConfigMap과 Secret을 통해 환경변수가 주입됩니다.
# ===============================================================================

# API 서버 포트
PORT=8080

# CORS 허용 주소 (로컬 프론트엔드 주소)
ALLOWED_ORIGINS=http://localhost:5173

# Redis 연결 정보 (로컬 Docker Redis 단일 노드 기준)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MySQL 연결 정보 (SSM 터널을 통해 127.0.0.1:3306으로 포트 포워딩됨)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=Password123!
DB_NAME=trail_db

## AWS 리소스 설정
AWS_REGION=ap-northeast-2
AWS_PROFILE=team
SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/009152047332/reservation-queue
MAIL_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/009152047332/mail-queue

# Cognito 검증 설정
USE_MOCK_AUTH=true
COGNITO_USER_POOL_ID=ap-northeast-2_XXXXXX  # 실제 AWS Cognito User Pool ID
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX      # 실제 AWS Cognito 앱 클라이언트 ID