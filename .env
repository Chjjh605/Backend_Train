# ==========================================================================
# 이 파일은 오직 로컬(내 컴퓨터)에서 개발/테스트할 때만 사용됩니다.
# AWS EKS나 Azure App Service 같은 클라우드 환경 배포 시에는 완전히 무시됩니다!!
# 클라우드의 환경변수는 모두 Terraform(main.tf 등)에서 자동으로 주입합니다.
# ==========================================================================

# 로컬 DB 연결 정보 예시
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=local_password
DB_NAME=trail_db

# 로컬 Redis 연결 정보 예시
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_AUTH_TOKEN=SecureRedisToken123! # 로컬 도커에 비밀번호가 있다면 추가