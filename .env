# ==============================================================================
# 💻 로컬 개발 환경 전용 설정 (.env)
# ⚠️ 주의: 이 파일은 로컬 PC 테스트 전용입니다.
# ☁️ AWS EKS 배포 시에는 이 파일 대신 ConfigMap과 Secret을 통해 환경변수가 주입됩니다.
# ==============================================================================

# API 서버 포트
PORT=8080

# CORS 허용 주소 (로컬 프론트엔드 주소)
ALLOWED_ORIGINS=http://localhost:5173

# Redis 연결 정보 (로컬 Docker Redis 단일 노드 기준)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MySQL 연결 정보 (로컬 Docker MySQL 기준)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=trail_db

# AWS 설정 (로컬 PC의 SQS 호출 시 사용)
AWS_REGION=ap-northeast-2
SQS_QUEUE_URL=여기에_테스트용_SQS_대기열_주소_입력