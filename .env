## app.js

# 서버 포트
PORT=8080

# Redis 연결 정보
# AWS 실행 시 REDIS_HOST를 ElastiCache 엔드포인트 주소로 변경
REDIS_HOST=127.0.0.1
# AWS 실행시 6379로 포트 번호 변경
REDIS_PORT=7000

## worker.js

# MySQL 로컬 연결 정보
# AWS 이관 시 DB_HOST를 Aurora/RDS 엔드포인트 주소로 변경
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=trail_db

## 공통 변수

AWS_REGION=ap-northeast-2

# AWS SQS 설정
SQS_QUEUE_URL=여기에_나중에_SQS_주소_붙여넣기